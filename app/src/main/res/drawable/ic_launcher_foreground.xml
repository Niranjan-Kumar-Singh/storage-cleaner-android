        android:fillColor="#00BCD4"
        android:pathData="M38,70 C36,66 38,62 42,60 L50,58 L52,68 C49,72 44,74 38,70 Z"/>

    <!-- Sparkle dots (clean effect) -->
    <circle android:fillColor="#FFFFFF" android:cx="66" cy="34" android:r="2"/>
    <circle android:fillColor="#FFD54F" android:cx="72" cy="42" android:r="1.5"/>
    <circle android:fillColor="#FFFFFF" android:cx="68" cy="50" android:r="1"/>

    <!-- Checkmark on shield (security) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46,52 L51,58 L62,44"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"/>

</vector>
