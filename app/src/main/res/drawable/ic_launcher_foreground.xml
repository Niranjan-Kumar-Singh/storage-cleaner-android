<?xml version="1.0" encoding="utf-8"?>
<!-- App icon: broom + shield — "clean & secure" concept -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Shield background -->
    <path
        android:fillColor="#1A237E"
        android:pathData="M54,10 L80,22 L80,46 C80,62 68,74 54,80 C40,74 28,62 28,46 L28,22 Z"/>

    <!-- Shield highlight -->
    <path
        android:fillColor="#3949AB"
        android:pathData="M54,15 L76,26 L76,46 C76,60 65,71 54,76 L54,15 Z"/>

    <!-- Broom stick -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#E0E0E0"
        android:strokeWidth="0.5"
        android:pathData="M42,65 L62,38 L65,41 L45,68 Z"/>

    <!-- Broom head -->
